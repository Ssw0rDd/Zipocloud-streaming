# Optional web overrides when running Next.js without the repo-root env loader.
# Prefer: `pnpm dev:web` (loads root `.env` via scripts/with-root-env.mjs).
# Copy root template first:  cp ../../.env.example ../../.env
# Full reference: docs/CONFIGURATION.md

API_URL=http://localhost:3001

# If you run `next` directly in this folder, mirror public flags here as needed:
# NEXT_PUBLIC_CINEMA_ENABLED=true
# NEXT_PUBLIC_EMBED_CINEMA_CHAT_ONLY=true

# JW Player (optional — HLS/MP4 paths with playerEngine=jwplayer)
# NEXT_PUBLIC_JWPLAYER_SCRIPT_URL=https://cdn.example.com/jwplayer.js
# NEXT_PUBLIC_JWPLAYER_ENABLED=true
