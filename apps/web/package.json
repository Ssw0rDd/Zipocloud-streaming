{
  "name": "@zipo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-root-env.mjs node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 3000",
    "dev:nsfw": "node scripts/with-root-env.mjs node scripts/dev-nsfw.mjs",
    "dev:clean": "node scripts/clean-next.mjs && node scripts/with-root-env.mjs node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 3000",
    "build": "node scripts/with-root-env.mjs node node_modules/next/dist/bin/next build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "start": "node scripts/with-root-env.mjs node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000",
    "start:nsfw": "node scripts/with-root-env.mjs node scripts/start-nsfw.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate-i18n": "bun scripts/validate-i18n.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@zipo/api-client": "workspace:*",
    "@zipo/shared": "workspace:*",
    "anime4k-webgpu": "^1.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
