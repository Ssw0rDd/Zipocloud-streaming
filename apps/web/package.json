{
  "name": "@zipo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-root-env.mjs node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 3000",
    "dev:nsfw": "node scripts/with-root-env.mjs node scripts/dev-nsfw.mjs",
    "dev:clean": "node scripts/clean-next.mjs && node scripts/with-root-env.mjs node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 3000",
    "build": "node scripts/with-root-env.mjs node node_modules/next/dist/bin/next build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "start": "node scripts/with-root-env.mjs node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000",
    "start:nsfw": "node scripts/with-root-env.mjs node scripts/start-nsfw.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate-i18n": "bun scripts/validate-i18n.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.8",
    "@zipo/api-client": "workspace:*",
    "@zipo/shared": "workspace:*",
    "anime4k-webgpu": "^1.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.23.0",
    "next": "^15.5.22",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "15.5.22",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.22",
    "eslint-plugin-react-hooks": "5.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
