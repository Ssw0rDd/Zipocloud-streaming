# ZiPo environment template
# Copy to `.env` at the repo root:  cp .env.example .env
# Full reference: docs/CONFIGURATION.md
# Third-party keys: docs/THIRD_PARTY_APIS.md
# Step-by-step setup: docs/SETUP.md

# -----------------------------------------------------------------------------
# Infrastructure
# Local API, web, and dual-site (NSFW) origins. See docs/CONFIGURATION.md.
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
# Local defaults. When TUNNEL_URL is set, browser origin + Better Auth follow the tunnel.
FRONTEND_URL=http://localhost:3000
NSFW_FRONTEND_URL=http://localhost:3002

# Database and cache
DATABASE_URL=postgresql://zipo:zipo@localhost:5434/zipo
REDIS_URL=redis://127.0.0.1:6379
# Production compose only: random base64url value with at least 32 characters.
REDIS_PASSWORD=change-me-to-a-random-base64url-32-char-value

# -----------------------------------------------------------------------------
# Auth (Better Auth)
# Production requires independent random secrets (32+ chars). Never commit real values.
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
# Optional when TUNNEL_URL is empty (defaults to FRONTEND_URL / localhost:3000).
# BETTER_AUTH_URL=http://localhost:3000

# HTTP security
# Optional CORS extras; localhost + TUNNEL_URL are merged by the API automatically.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Auto-enabled when TUNNEL_URL is set. Force with true/false if needed.
# TRUST_PROXY_HEADERS=
VIEWS_FLUSH_INTERVAL_MS=30000

# -----------------------------------------------------------------------------
# Feature flags
# Cinema/worker stay opt-in. Safe defaults for a new open clone.
# -----------------------------------------------------------------------------
SEARCH_V2_ENABLED=true
PLAYBACK_V2_ENABLED=true
NATIVE_PLAYER_ONLY=true
SECURE_EMBED_FALLBACK_ENABLED=false
OWN_PREROLL_ENABLED=false
CINEMA_ENABLED=false
# false = full Cinema when primary native source is available. true = chat/presence only.
EMBED_CINEMA_CHAT_ONLY=false
IMAGE_PIPELINE_V2=false
HOME_CACHE_V3=false
DARK_UI_V2=false
PWA_ENABLED=false
ADS_ENABLED=false
# API/product flag. Enable only when at least one media-worker is running.
CLIPS_ENABLED=false
# Process role flag. Keep false in API replicas and true only in media workers.
MEDIA_WORKER_ENABLED=false
MEDIA_PREPARATION_ENABLED=false
# Worker-only: auto|nvenc|amf|none
FFMPEG_HWACCEL=auto
CLIP_QUEUE_MAX_DEPTH=200
# Concurrent clip jobs per user (queued/processing slots)
CLIP_MAX_ACTIVE_PER_USER=10
PREPARATION_QUEUE_MAX_DEPTH=100

# Opaque playback sessions and first-party preroll
PLAYBACK_SESSION_TTL_SECONDS=600
PLAYBACK_SESSION_SECRET=change-me-to-an-independent-random-32-char-secret
OWN_PREROLL_URL=/zipo-preroll.webm
OWN_PREROLL_SKIP_SECONDS=5
OWN_PREROLL_FREQUENCY_SECONDS=1800

# Cinema ZiPo
CINEMA_ROOM_IDLE_HOURS=24
CINEMA_MAX_PARTICIPANTS=50
CINEMA_ACCESS_SECRET=change-me-to-an-independent-random-32-char-secret

# -----------------------------------------------------------------------------
# Storage / media workers
# Private MinIO/S3 for prepared media. Defaults match docker compose.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zipo-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-in-production
S3_FORCE_PATH_STYLE=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
INTERNAL_API_URL=http://localhost:3001
MEDIA_CACHE_TTL_SECONDS=21600
# Required in production when MEDIA_PREPARATION_ENABLED=true.
MEDIA_SOURCE_ENCRYPTION_KEY=change-me-to-an-independent-random-32-char-secret

# Cinema HLS Stream Bridge (Python service on :8090)
STREAM_BRIDGE_ENABLED=false
STREAM_BRIDGE_URL=http://localhost:8090
STREAM_BRIDGE_SECRET=change-me-to-an-independent-random-32-char-secret
STREAM_BRIDGE_TIMEOUT_MS=8000
STREAM_BRIDGE_PREPARE_TIMEOUT_MS=120000
STREAM_BRIDGE_JOB_DB=./data/stream-bridge/jobs.sqlite3
STREAM_BRIDGE_MAX_ACTIVE_JOBS=32
STREAM_BRIDGE_MAX_JOB_RECORDS=2000
STREAM_BRIDGE_WORKERS=2
# Optional exact hosts or explicit suffixes (for example `.media.example.com`).
# Keep empty unless a licensed media CDN is required by the bridge.
STREAM_BRIDGE_ALLOWED_MEDIA_HOSTS=

# First-party sequential encrypted segment delivery. The source directory is
# read-only and contains <videoId>/segment-000000.ts plus stream.json.
PROTECTED_STREAM_ENABLED=false
PROTECTED_STREAM_MASTER_SECRET=change-me-to-an-independent-random-32-char-secret
PROTECTED_STREAM_ROOT=./data/protected-streams
PROTECTED_STREAM_ROOT_HOST=./data/protected-streams

# Production TLS edge. Directory must contain fullchain.pem and privkey.pem.
TLS_CERT_DIR=./secrets/tls

# -----------------------------------------------------------------------------
# Playback providers
# Defaults are off for a safe public clone. Enable only sources you operate or
# are licensed to use. Third-party signup links: docs/THIRD_PARTY_APIS.md
# A private first-party provider slot may exist in your fork; it is intentionally
# not documented for the public project (set ENABLED=false unless you own it).
# -----------------------------------------------------------------------------
SUPERFLIX_ENABLED=false
SUPERFLIX_BASE_URL=https://superflixapi.pro
WAREZCDN_ENABLED=false
WAREZCDN_BASE_URL=https://warezcdn.lat

# Private operator-owned player/provider config (not publicly documented).
# Leave disabled unless you control these origins yourself.
MEGAFRIX_ENABLED=false
MEGAFRIX_BASE_URL=https://provider.example.com
MEGAFRIX_APP_PATH=/
MEGAFRIX_EMBED_ORIGINS=https://media.example.com,https://cdn.example.com

# Owned/licensed gateway fallback (server-to-server). Exact HTTPS origins only.
MEGAFLIX_GATEWAY_ENABLED=false
MEGAFLIX_GATEWAY_URL=https://gateway.example.com/internal/v2/playback/resolve
MEGAFLIX_GATEWAY_SECRET=change-me-to-an-independent-random-32-char-secret
MEGAFLIX_MEDIA_ORIGINS=https://media.example.com,https://cdn.example.com
MEGAFLIX_GATEWAY_TIMEOUT_MS=8000

# Optional server-to-server resolver for media you own or are licensed to use.
# Never point this at an iframe extractor or expose its secret to a browser/app.
AUTHORIZED_MEDIA_ENABLED=false
AUTHORIZED_MEDIA_RESOLVER_URL=https://resolver.example.com/v1/resolve
AUTHORIZED_MEDIA_RESOLVER_SECRET=change-me-to-an-independent-random-32-char-secret
AUTHORIZED_MEDIA_ORIGINS=https://media.example.com,https://cdn.example.com
AUTHORIZED_MEDIA_TIMEOUT_MS=5000

# Optional catalog embeds (operator-supplied BASE_URL). Respect each provider's ToS.
VIDEASY_ENABLED=false
VIDEASY_BASE_URL=https://player.videasy.net
VIDKING_ENABLED=false
VIDKING_BASE_URL=https://www.vidking.net
VIDLINK_ENABLED=false
VIDLINK_BASE_URL=https://vidlink.pro
VIDSRC_ENABLED=false
VIDSRC_BASE_URL=https://vidsrc.win
TWOEMBED_ENABLED=false
TWOEMBED_BASE_URL=https://www.2embed.cc
SUPERFLIX_SYNC_INTERVAL_MS=3600000
SUPERFLIX_CATALOG_MAX_AGE_MS=7200000

# -----------------------------------------------------------------------------
# Payments (Mercado Pago Pix — Lifetime Supporter)
# Amount is fixed server-side in cents. Keys: docs/THIRD_PARTY_APIS.md
# -----------------------------------------------------------------------------
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
SUPPORTER_PIX_AMOUNT_CENTS=
SUPPORTER_PIX_EXPIRATION_MINUTES=30

# -----------------------------------------------------------------------------
# Catalog / metadata API keys
# Without TMDB the home/catalog experience degrades. Details: docs/THIRD_PARTY_APIS.md
# -----------------------------------------------------------------------------
# TMDB v4 Read Access Token (not the v3 API key). Strongly recommended.
TMDB_ACCESS_TOKEN=

# Optional catalog enrichment
TRAKT_CLIENT_ID=
OMDB_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Required with AniList OAuth. Generate an independent random 32+ character key.
OAUTH_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# Browser requests stay same-origin. API_URL is server-only (Next rewrite).
# Dual-site: use `pnpm dev:web:nsfw` / `pnpm start:nsfw` — do not set SITE_MODE=nsfw on main :3000.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_MODE=main
NEXT_PUBLIC_SITE_NAME=ZiPo
NEXT_PUBLIC_ANIME4K_ENABLED=false
NEXT_PUBLIC_CINEMA_ENABLED=false
NEXT_PUBLIC_EMBED_CINEMA_CHAT_ONLY=false
NEXT_PUBLIC_PWA_ENABLED=false
NEXT_PUBLIC_DARK_UI_V2=false
NEXT_PUBLIC_ADS_ENABLED=false
# Comma-separated allowlist for Next image optimizer + API image pipeline.
# `**.anilist.co` allows CDN node rotation. Do not add untrusted third-party CDNs.
NEXT_IMAGE_HOSTS=image.tmdb.org,images.metahub.space,live.metahub.space,cdn.myanimelist.net,api-cdn.myanimelist.net,media.kitsu.app,media.kitsu.io,static.tvmaze.com,**.anilist.co,shikimori.one,m.media-amazon.com

# -----------------------------------------------------------------------------
# Optional development tunnels (origin only — no path)
# cloudflared tunnel --url http://127.0.0.1:3000 → paste https://….trycloudflare.com here; restart API only.
# -----------------------------------------------------------------------------
TUNNEL_URL=
# NSFW: cloudflared --url http://127.0.0.1:3002
NSFW_TUNNEL_URL=
